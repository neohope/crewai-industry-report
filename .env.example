# ========================================
# 行业研究报告生成系统 - 环境配置
# ========================================

# OpenAI API 配置（必需）
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI 模型选择（可选，默认 gpt-4o）
# 可选值: gpt-4o, gpt-4-turbo, gpt-3.5-turbo 等
OPENAI_MODEL_NAME=gpt-4o

# ========================================
# 飞书集成配置（可选）
# ========================================
# 飞书应用凭证 - 用于发布文档和发送消息
# 获取地址: https://open.feishu.cn/
LARK_APP_ID=your-lark-app-id-here
LARK_APP_SECRET=your-lark-app-secret-here

# 飞书接收者ID - 用于发送消息通知
# 可以是用户的 open_id 或 email
LARK_RECEIVER_ID=user@example.com

# 飞书文件夹Token - 用于指定文档保存位置
LARK_FOLDER_TOKEN=folder-token-here

# ========================================
# 工具配置（可选）
# ========================================
# 是否使用byted-web-search技能进行搜索
USE_BYTED_WEB_SEARCH=true

# 默认搜索返回结果数
DEFAULT_MAX_RESULTS=10

# 默认搜索权威等级（0=全部，1=仅权威来源）
DEFAULT_AUTH_LEVEL=0

# 是否启用搜索查询改写
ENABLE_QUERY_REWRITE=false

# 是否使用lark相关技能（lark-doc/lark-im/lark-drive）
USE_LARK_SKILL=true

# 是否允许使用本地文件系统作为飞书技能的后备
USE_LOCAL_FALLBACK=true

# ========================================
# 超时和Kill配置（重要）
# ========================================

# 整个项目的最大运行时间（秒）
# 超过此时间会强制终止，默认 7200 秒（2小时）
PROJECT_TIMEOUT=7200

# 单个阶段的最大运行时间（秒）
# 超过此时间会kill该阶段，默认 3600 秒（1小时）
STAGE_TIMEOUT=3600

# 单个任务的最大运行时间（秒）
# 超过此时间会kill该任务，默认 1800 秒（30分钟）
TASK_TIMEOUT=1800

# 数据采集阶段超时（秒）
# 3个采集员并行运行的超时时间，默认 2400 秒（40分钟）
COLLECTION_TIMEOUT=2400

# 数据分析阶段超时（秒）
ANALYSIS_TIMEOUT=600

# 报告撰写阶段超时（秒）
WRITE_TIMEOUT=1200

# 报告评价阶段超时（秒）
REVIEW_TIMEOUT=600

# 报告发布阶段超时（秒）
PUBLISH_TIMEOUT=300

# ========================================
# 迭代和质量控制配置
# ========================================
# 最大审核迭代次数
MAX_REVIEW_ITERATIONS=2

# 通过评分阈值（0-100）
# 达到或超过此分数视为通过
PASSING_SCORE=95

# ========================================
# 日志和调试配置
# ========================================
# 是否启用详细日志
VERBOSE=true

# 是否保存中间结果
SAVE_INTERMEDIATE_RESULTS=true

# ========================================
# 安全配置
# ========================================
# 是否启用API调用限流
ENABLE_RATE_LIMIT=true

# API调用最小间隔（秒）
API_CALL_INTERVAL=0.1
