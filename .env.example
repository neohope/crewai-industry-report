# ========================================
# 行业研究报告生成系统 - 环境配置
# ========================================
# LLM配置
# 请选择以下四种方式之一，并将对应的 USE_* 设置为 true
# ========================================

# ========================================
# 方式一：官方 OpenAI API（可选）
# ========================================
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL_NAME=

# ========================================
# 方式二：OpenAI 兼容第三方 API（可选）
# ========================================
# 适用于：通义千问、智谱AI、豆包、本地模型等
USE_OPENAI_COMPATIBLE=false
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL_NAME=

# ========================================
# 方式三：Azure OpenAI（可选）
# ========================================
USE_AZURE_OPENAI=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=

# ========================================
# 方式四：Anthropic Claude（可选）
# ========================================
USE_ANTHROPIC=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=

# ========================================
# 飞书集成配置（可选）
# ========================================
LARK_DOMAIN="https://open.feishu.cn"
LARK_APP_ID=
LARK_APP_SECRET=

# 飞书接收者 ID - 用于发送消息通知
# 可以是用户的 open_id 或 email
LARK_RECEIVER_ID=

# 飞书文件夹 Token - 用于指定文档保存位置
LARK_FOLDER_TOKEN=

# ========================================
# byted-web-search配置
# ========================================
WEB_SEARCH_API_KEY=

# ========================================
# 迭代和质量控制配置
# ========================================
# 最大审核迭代次数
MAX_REVIEW_ITERATIONS=2

# 通过评分阈值（0-100）
# 达到或超过此分数视为通过
PASSING_SCORE=95
